GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile

TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

LOOP_INTERVAL_MINUTES=10
DB_PATH=seen_articles.db

# Passe à true seulement sur un vrai VPS (nécessite `scrapling install`)
# Active la collecte Motley Fool (config.SCRAPLING_SOURCES)
USE_SCRAPLING=false

# Sentiment de marché StockTwits par ticker (nécessite aussi scrapling install,
# solve_cloudflare)
USE_STOCKTWITS=false
STOCKTWITS_SYMBOLS=AAPL,TSLA,MSFT,GOOGL,AMZN,NVDA,META

# Sentiment retail Reddit (API officielle). Crée une app "script" sur
# https://www.reddit.com/prefs/apps pour obtenir client_id/secret.
USE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="python:stock-alert-bot:1.0 (by /u/change_me)"
REDDIT_SUBREDDITS=stocks,wallstreetbets,investing

# Tickers / noms d'entreprises surveillés, séparés par des virgules
WATCHED_KEYWORDS=AAPL,Apple,TSLA,Tesla,MSFT,Microsoft,GOOGL,Google,Alphabet,AMZN,Amazon,NVDA,Nvidia,META,Meta
